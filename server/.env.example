# ─── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on.
PORT=5000

# Runtime environment. Controls log verbosity, stack trace exposure, and
# Morgan request logger format. Valid values: development | production | test
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────────
# Full MongoDB connection URI. For local dev: mongodb://127.0.0.1:27017/cadence
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/cadence?retryWrites=true
MONGODB_URI=mongodb://127.0.0.1:27017/cadence

# ─── Redis ─────────────────────────────────────────────────────────────────────
# ioredis-compatible connection URL. BullMQ queues will be registered against this.
# Local: redis://127.0.0.1:6379
# Upstash / Redis Cloud: redis://:password@host:port
REDIS_URL=redis://127.0.0.1:6379

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS. In development this is
# typically the Vite / CRA dev server. In production set to your frontend domain.
# Example: https://cadence.app,https://www.cadence.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign JSON Web Tokens. Must be at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED — server will refuse to start without this.
JWT_SECRET=replace_me_with_a_long_random_string

# ─── Email Service (for password reset) ─────────────────────────────────────────
# Email service provider. Options: gmail, sendgrid, ses, mailgun
EMAIL_SERVICE=gmail

# SMTP configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@cadence.app

# ─── Ollama (local LLM) ───────────────────────────────────────────────────────────────
# Base URL of the locally running Ollama instance.
# Run `ollama serve` to start, then `ollama pull llama3.1` to pull the model.
# Change if you're running Ollama on a different host/port.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Exact model name as returned by `ollama list`. Must already be pulled.
OLLAMA_MODEL=llama3.1
